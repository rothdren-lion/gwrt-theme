#!/bin/sh
# gwrt-dns-rescue - run the GWRT DNS rescue script for the dashboard.
# Requires a valid LuCI session id passed as ?sid=<ubus_rpc_session>.
# (uhttpd does not forward HTTP_COOKIE to cgi scripts, so the page JS
# appends the session token it already has.)

sid=$(printf '%s' "$QUERY_STRING" | sed -n 's/.*sid=\([^&]*\).*/\1/p')

printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'

if [ -z "$sid" ]; then
	printf '%s\n' '{"ok":false,"actions":[],"warnings":["unauthorized"],"test":""}'
	exit 0
fi

ubus call session get "{ \"ubus_rpc_session\": \"$sid\" }" >/dev/null 2>&1 || {
	printf '%s\n' '{"ok":false,"actions":[],"warnings":["unauthorized"],"test":""}'
	exit 0
}

if [ -x /usr/libexec/gwrt-dns-rescue ]; then
	exec /usr/libexec/gwrt-dns-rescue
fi

printf '%s\n' '{"ok":false,"actions":[],"warnings":["gwrt-dns-rescue not installed"],"test":""}'
