#!/bin/sh /etc/rc.common

START=99
STOP=05
USE_PROCD=1

start_service() {
	[ -x /usr/libexec/gwrt-apk-autoinstall ] || return 0
	procd_open_instance
	procd_set_param command /usr/libexec/gwrt-apk-autoinstall
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 10
	procd_close_instance
}
