config gwrt 'usb_lan'
	option enabled '0'
	option auto_bridge '1'

config gwrt 'theme'
	option mode 'dark'
	option port_81 '/luci-static/bootstrap'
	option port_444 '/luci-static/bootstrap'

config he 'he'
	option enabled '1'
	option enable_2g '0'

config ota 'ota'
	option enabled '1'
	option channel 'stable'
	option manifest_base_url 'https://raw.githubusercontent.com/rothdren-lion/gwrt-ota/main/gwrt-ota/stable'
