{#
	GWRT is a modern dark-first LuCI theme inspired by gwrt.uk

	luci-theme-gwrt
	Copyright 2025 GWRT Contributors

	Licensed to the public under the Apache License 2.0
-#}
{%
	import { access } from 'fs';
	import { cursor } from 'uci';
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');

	const _qs = getenv('QUERY_STRING') ?? '';
	const _clean = match(_qs, /(^|&)gwrt_clean=1(&|$)/) != null;

	let cfg = cursor();

	//send as HTML5
	http.prepare_content('text/html; charset=UTF-8');

	//Custom settings
	let mode = 'dark';
	let bar_color = '#0a0e1a';
	if (access('/etc/config/gwrt')) {
		mode = cfg.get_first('gwrt', 'theme', 'mode') ?? 'dark';
		bar_color = (mode == 'light') ? '#f5f6fa' : '#0a0e1a';
	}

-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>

	<!-- SEO and Description -->
	<meta name="robots" content="noindex, nofollow">

	<!-- Security -->
	<meta http-equiv="X-Content-Type-Options" content="nosniff">
	<meta http-equiv="X-Frame-Options" content="SAMEORIGIN">
	<meta http-equiv="X-XSS-Protection" content="1; mode=block">
	<meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

	<!-- Mobile and PWA -->
	<meta name="format-detection" content="telephone=no, email=no">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
	<meta name="apple-mobile-web-app-title" content="{{ hostname }} - LuCI">

	<!-- Theme and Colors -->
	<meta name="theme-color" content="{{ bar_color }}">
	<meta name="msapplication-TileColor" content="{{ bar_color }}">
	<meta name="application-name" content="{{ hostname }} - LuCI">

	<!-- Icons -->
	<link rel="icon" type="image/svg+xml" href="/luci-static/gwrt/img/logo.svg">
	<link rel="shortcut icon" type="image/svg+xml" href="/luci-static/gwrt/img/logo.svg">

	<!-- Font Preloads -->
	<link rel="preload" href="/luci-static/gwrt/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/luci-static/gwrt/fonts/Inter-SemiBold.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/luci-static/gwrt/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin>

	<!-- Anti-FOUC: set theme before paint -->
	<script>
		(function(){
			var t;
			try { t = localStorage.getItem('gwrt-theme'); } catch(e) {}
			if (!t) t = '{{ mode }}' || 'dark';
			document.documentElement.setAttribute('data-theme', t);
		})();
	</script>

	<!-- Main Stylesheet -->
	<link rel="stylesheet" href="/luci-static/gwrt/css/cascade.css?v=20260903r88">

	<!-- Stylesheets -->
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css}}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}
		<script src="/luci-static/gwrt/resources/menu-i18n.js?v=20260903r88"></script>
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}-t{{ pkgs_update_time }}"></script>
	<script src="{{ resource }}/luci.js?v={{ version.luciversion }}-t{{ pkgs_update_time }}"></script>
</head>

<body
	class="lang_{{ dispatcher.lang }} {% if (ctx.authsession): %}logged-in{% endif %}"
	data-page="{{ entityencode(join('-', ctx.request_path), true) }}">

	<div class="main">
		{% if (!_clean): %}
		<div class="main-left" id="mainmenu" style="display:none"></div>
		{% endif %}
		<div class="main-right">
			{% if (!_clean): %}
			<header class="luci-navbar">
				<div class="fill">
					<div class="container">
						<div class="flex1">
							<a class="showSide"></a>
							<a class="brand" href="{{ dispatcher.build_url('admin/status') }}">
								<span class="brand-text">{{ hostname }}</span>
							</a>
						</div>
							<div class="navbar-controls">
								<a class="gwrt-native-link" href="#" title="原生 LuCI · 81" aria-label="打开原生 LuCI · 81" onclick="var p=location.port||(location.protocol==='https:'?'443':'80');var secure=location.protocol==='https:'||p==='444'||p==='443';location.href=(secure?'https':'http')+'://'+location.hostname+':'+(secure?'444':'81')+location.pathname+location.search+location.hash;return false;"><span class="gwrt-go-badge" aria-hidden="true">G/O</span></a>
								<button type="button" class="theme-toggle gwrt-theme-toggle" data-gwrt>
								<span class="theme-toggle-icon theme-toggle-icon-dark" aria-hidden="true">&#9790;</span>
								<span class="theme-toggle-icon theme-toggle-icon-light" aria-hidden="true">&#9728;</span>
							</button>
							<button type="button" class="lang-toggle gwrt-lang-toggle" data-lang="en">EN</button>
							<button type="button" class="lang-toggle gwrt-reboot-btn" id="gwrtRebootBtn" title="重启路由" aria-label="重启路由">&#8635;</button>
							<div class="status" id="indicators"></div>
						</div>
					</div>
				</div>
			</header>
			<div class="darkMask"></div>
			{% endif %}
			<div id="maincontent">
				<div class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message error">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/password")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/password") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
					{% endif %}

					{% if (boardinfo?.initramfs): %}
					<div class="alert-message warning">
						<h4>{{ _('Running in initramfs') }}</h4>
						<p>{{ _('The system is currently running from RAM. Any changes will be lost after reboot. Flash a firmware image to make changes permanent.') }}</p>
					</div>
					{% endif %}

					<noscript>
						<div class="alert-message error">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
