var GWRT_ICON_IMG={
  openclash:'/luci-static/resources/openclash/img/logo.png',
  aria2:'/ariang/tileicon.png',
  daed:'/luci-static/gwrt/img/daed.png',
  passwall:'/luci-static/gwrt/img/plugin_icons/passwall.png',
  smartdns:'/luci-static/gwrt/img/plugin_icons/smartdns.png',
  easytier:'/luci-static/gwrt/img/plugin_icons/easytier.png',
  'podman-market':'/luci-static/gwrt/img/plugin_icons/podman.png',
  wireguard:'/luci-static/gwrt/img/plugin_icons/wireguard.png'
};
function gwrtIcon(name){
  var img=GWRT_ICON_IMG[name];
  if(img)return '<img src="'+img+'" alt="" loading="lazy">';
  var p=GWRT_ICON_SVG[name]||'<circle cx="12" cy="12" r="3"/><path d="M12 1v4"/><path d="M12 19v4"/><path d="M1 12h4"/><path d="M19 12h4"/>';
  return '<svg viewBox="0 0 24 24">'+p+'</svg>';
}
function gwrtMenuChildren(node){
  var out=[];
  if(!node||!node.children)return out;
  for(var k in node.children){
    var c=node.children[k];
    if(!c||c.satisfied===false||c.title==null)continue;
    out.push({name:k,title:c.title,children:c.children||{},order:c.order||1000});
  }
  out.sort(function(a,b){return a.order-b.order;});
  return out;
}
var gwrtMenuCache=null,gwrtMenuLoadPending=null;
function gwrtLoadMenu(){
  if(gwrtMenuCache)return Promise.resolve(gwrtMenuCache);
  if(gwrtMenuLoadPending)return gwrtMenuLoadPending;
  gwrtMenuLoadPending=fetch(L.url('admin/menu')).then(function(r){
    if(!r.ok)throw new Error('menu '+r.status);
    return r.json();
  }).then(function(j){gwrtMenuCache=j;return j;}).catch(function(){return null;});
  return gwrtMenuLoadPending.then(function(menu){gwrtMenuLoadPending=null;return menu;});
}
function gwrtHref(chain){
  var u='/cgi-bin/luci';
  for(var i=0;i<chain.length;i++)u+='/'+chain[i];
  return u;
}
function gwrtMenuTitle(name,title,href){
  try{if(window.GwrtMenuI18n)return window.GwrtMenuI18n.resolve(name,title,href);}catch(e){}
  return title||name||'';
}
function gwrtLeaf(n,path){
  var href=gwrtHref(path.concat(n.name));
  return {name:n.name,title:gwrtMenuTitle(n.name,n.title,href),icon:n.name,href:href};
}
/* 运行时探测 ttyd 是否存在，存在才注入终端图标，避免死链接 */
var gwrtTtydCheck=null;
function gwrtProbeTtyd(){
  if(gwrtTtydCheck)return gwrtTtydCheck;
  gwrtTtydCheck=rpcD('file','stat',{path:'/usr/bin/ttyd'}).then(function(st){
    return !!(st&&st.type!==undefined);
  }).catch(function(){return false;});
  return gwrtTtydCheck;
}
function gwrtGridDefs(menu,hasTtyd){
  var root=(menu&&menu.children&&menu.children.admin)||menu||{};
  var kids=gwrtMenuChildren(root),byName={};
  kids.forEach(function(n){byName[n.name]=n;});
  var appf=byName['appfilter'],hf=byName['harbor_file'];
  var net=byName['network'],svc=byName['services'],nas=byName['nas'],sys=byName['system'],vpn=byName['vpn'];
  var netChildren=net?gwrtMenuChildren(net):[];
  var vpnNet=netChildren.filter(function(n){return n.name==='vpn'||/^vpn$/i.test(String(n.title||''));})[0];
  var netItems=netChildren.filter(function(n){return n!==vpnNet;}).map(function(n){return gwrtLeaf(n,['admin','network']);});
  var svcItems=svc?gwrtMenuChildren(svc).map(function(n){return gwrtLeaf(n,['admin','services']);}):[];
  function addVpnItems(node,path,prefix){
    if(!node)return;
    var children=gwrtMenuChildren(node);
    if(!children.length&&node.title){svcItems.push({name:prefix+'-'+node.name,title:gwrtMenuTitle(node.name,node.title,gwrtHref(path)),icon:node.name,href:gwrtHref(path)});return;}
    children.forEach(function(n){var href=gwrtHref(path.concat(n.name));svcItems.push({name:prefix+'-'+n.name,title:gwrtMenuTitle(n.name,n.title,href),icon:n.name,href:href});});
  }
  addVpnItems(vpn,['admin','vpn'],'vpn');
  addVpnItems(vpnNet,['admin','network','vpn'],'network-vpn');
  if(byName['store'])svcItems.push({name:'store',title:gwrtMenuTitle('store','iStore 应用商店',gwrtHref(['admin','store'])),icon:'store',href:gwrtHref(['admin','store'])});
  if(hasTtyd){
    var ttydPort=((document.getElementById('gwrt-dashboard-container')||{}).getAttribute)?document.getElementById('gwrt-dashboard-container').getAttribute('data-ttyd-port')||'7681':'7681';
    var ttydProto=(location.protocol==='https:')?'https':'http';
    svcItems.push({name:'terminal',title:'终端',icon:'terminal',href:ttydProto+'://'+location.hostname+':'+ttydPort+'/'});
  }
  var storeItems=[];
  (nas?gwrtMenuChildren(nas):[]).forEach(function(n){storeItems.push(gwrtLeaf(n,['admin','nas']));});
  if(hf)storeItems.push(gwrtLeaf(hf,['admin']));
  var overviewItems=[];
  (sys?gwrtMenuChildren(sys):[]).forEach(function(n){if(n.name!=='plugins'&&n.name!=='reboot')overviewItems.push(gwrtLeaf(n,['admin','system']));});
  if(appf)overviewItems.push(gwrtLeaf(appf,['admin']));
  var statusNode=byName['status'];
  if(statusNode){
    var stSeen={};
    gwrtMenuChildren(statusNode).forEach(function(n){
      if(n.name==='overview')return;
      var tkey=String(n.title||'').toLowerCase();
      if(tkey&&stSeen[tkey])return;
      stSeen[tkey]=1;
      var leaf=gwrtLeaf(n,['admin','status']);
      leaf.name='status-'+n.name;
      overviewItems.push(leaf);
    });
  }
  var svcSeen={};svcItems=svcItems.filter(function(item){if(!item.href||svcSeen[item.href])return false;svcSeen[item.href]=1;return true;});
  return {overview:overviewItems,net:netItems,service:svcItems,store:storeItems};
}
function gwrtItemKey(item){return String(item&&((item.href)||item.name)||'');}
function gwrtItemLegacyKey(item){return String(item&&item.name||'');}
function gwrtApplyOrder(items,key){
  try{
    var order=JSON.parse(localStorage.getItem('gwrt-order-'+key)||'null');
    if(Array.isArray(order)){
      var byKey={},byLegacy={},used={},out=[];
      items.forEach(function(it){var id=gwrtItemKey(it);byKey[id]=it;if(!byLegacy[gwrtItemLegacyKey(it)])byLegacy[gwrtItemLegacyKey(it)]=it;});
      order.forEach(function(saved){var it=byKey[saved]||byLegacy[saved],id=it&&gwrtItemKey(it);if(it&&!used[id]){out.push(it);used[id]=true;}});
      items.forEach(function(it){var id=gwrtItemKey(it);if(!used[id])out.push(it);});
      return out;
    }
  }catch(e){}
  return items;
}
function gwrtSaveOrder(grid,key){
  if(!grid||!key)return;
  var order=[].map.call(grid.querySelectorAll('.icon-item'),function(x){return x.getAttribute('data-key');});
  try{localStorage.setItem('gwrt-order-'+key,JSON.stringify(order));}catch(e){}
}
function gwrtInsertDragAtPointer(grid,event){
  var drag=gwrtDrag,el=drag&&drag.el;
  if(!el)return;
  var items=[].slice.call(grid.querySelectorAll('.icon-item:not(.dragging)'));
  var before=null;
  for(var i=0;i<items.length;i++){
    var rect=items[i].getBoundingClientRect();
    if(event.clientY<rect.top+rect.height/2||(event.clientY<=rect.bottom&&event.clientX<rect.left+rect.width/2)){before=items[i];break;}
  }
  if(before)grid.insertBefore(el,before);else grid.appendChild(el);
}
function gwrtPersistDrag(drag,targetGrid){
  var targetKey=targetGrid&&targetGrid.dataset.gwrtGroup;
  if(!drag||!drag.el||!targetGrid||!targetKey)return;
  if(drag.key!==targetKey)gwrtSetGroup(drag.el.getAttribute('data-key'),targetKey);
  gwrtSaveOrder(drag.grid,drag.key);
  if(targetGrid!==drag.grid)gwrtSaveOrder(targetGrid,targetKey);
  drag.targetGrid=targetGrid;
  drag.committed=true;
}
var gwrtDrag=null;
function gwrtSetupGrid(grid,key){
  grid.dataset.gwrtGroup=key;
  grid.querySelectorAll('.icon-item').forEach(function(t){
    t.addEventListener('dragstart',function(e){
      gwrtDrag={grid:grid,el:t,key:key,originNext:t.nextSibling,targetGrid:grid,committed:false};
      t.classList.add('dragging');
      try{e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',t.getAttribute('data-key'));}catch(err){}
    });
    t.addEventListener('dragend',function(){
      var drag=gwrtDrag;
      t.classList.remove('dragging');
      document.querySelectorAll('.icon-item.dragging').forEach(function(x){x.classList.remove('dragging');});
      document.querySelectorAll('.gwrt-grid-drop-active').forEach(function(x){x.classList.remove('gwrt-grid-drop-active');});
      if(drag&&drag.el===t){
        if(!drag.committed){
          if(t.parentNode!==drag.grid)drag.grid.insertBefore(t,drag.originNext&&drag.originNext.parentNode===drag.grid?drag.originNext:null);
          gwrtSaveOrder(drag.grid,drag.key);
        }
        gwrtDrag=null;
      }
      t._gwrtJustDragged=true;
      setTimeout(function(){t._gwrtJustDragged=false;},250);
    });
  });
  if(grid._gwrtDragBound)return;
  grid._gwrtDragBound=true;
  grid.addEventListener('dragover',function(e){
    if(!gwrtDrag||!gwrtDrag.el)return;
    e.preventDefault();
    try{e.dataTransfer.dropEffect='move';}catch(err){}
    gwrtInsertDragAtPointer(grid,e);
    grid.classList.add('gwrt-grid-drop-active');
  });
  grid.addEventListener('dragleave',function(e){if(!e.relatedTarget||!grid.contains(e.relatedTarget))grid.classList.remove('gwrt-grid-drop-active');});
  grid.addEventListener('drop',function(e){
    if(!gwrtDrag||!gwrtDrag.el)return;
    e.preventDefault();
    grid.classList.remove('gwrt-grid-drop-active');
    gwrtPersistDrag(gwrtDrag,grid);
  });
}
function gwrtRenderGrid(gridEl,items,key){
  if(!gridEl)return;
  gridEl.removeAttribute('aria-busy');
  gridEl.dataset.gwrtLoaded='1';
  items=gwrtApplyOrder(items,key);
  gridEl.innerHTML=items.map(function(it){
    var itemKey=gwrtItemKey(it),title=gwrtMenuTitle(it.name,it.title,it.href);
    return '<div class="icon-item" draggable="true" data-key="'+esc(itemKey)+'" data-href="'+esc(it.href)+'" data-title="'+esc(title)+'" title="'+esc(title)+'">'
      +'<div class="icon-item-ico">'+gwrtIcon(it.icon)+'</div><span class="icon-item-t">'+esc(title)+'</span></div>';
  }).join('');
  gridEl.querySelectorAll('.icon-item').forEach(function(t){
    t.addEventListener('click',function(){
      if(t._gwrtJustDragged)return;
      gwrtOpenModal(t.getAttribute('data-href'),t.getAttribute('data-title')||t.title||'');
    });
  });
  gwrtSetupGrid(gridEl,key);
}
var gwrtModalEl=null;
function gwrtCleanFrame(f,isHarbor){
  try{
    var d=f.contentDocument;
    if(!d)return;
    var st=d.getElementById('gwrt-noside-style');
    if(!st){
      st=d.createElement('style');
      st.id='gwrt-noside-style';
      st.textContent='.luci-navbar,.darkMask,footer.mobile-hide{display:none!important}#mainmenu,.main-left{display:none!important}.main > .main-right{margin-left:0!important}.showSide{display:none!important}.cbi-page-actions{display:none!important}';
      (d.head||d.documentElement).appendChild(st);
    }
    if(isHarbor){
      var hb=d.getElementById('gwrt-harbor-style');
      if(!hb){
        hb=d.createElement('style');
        hb.id='gwrt-harbor-style';
        hb.textContent='.main-right{padding-top:0!important}#maincontent{height:100vh!important;box-sizing:border-box;overflow:hidden;padding:0!important}#maincontent>.container{max-width:none!important;width:100%!important;margin:0!important;padding:0!important;height:100vh!important;display:flex!important;flex-direction:column!important}.file-manager{flex:1 1 auto!important;height:auto!important;min-height:0!important;max-height:none!important;margin:8px}';
        (d.head||d.documentElement).appendChild(hb);
      }
    }
  }catch(e){}
}
var gwrtModalIcons={
  close:'<svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
  max:'<svg viewBox="0 0 24 24"><rect x="5" y="5" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>',
  save:'<svg viewBox="0 0 24 24"><path d="M4 4h13l3 3v13H4z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8 4v6h8V4M8 20v-7h8v7" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>',
  reset:'<svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 1 2.34 5.66" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M4 12V6m0 6h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>'
};
function gwrtModalSetSaving(frame,saving){
  if(!gwrtModalEl)return;
  var save=gwrtModalEl.querySelector('.gwrt-modal-save');
  if(save){save.disabled=!!saving;save.classList.toggle('is-busy',!!saving);}
  if(!saving)return;
  if(frame._gwrtSaveTimer)clearTimeout(frame._gwrtSaveTimer);
  frame._gwrtSaveTimer=setTimeout(function(){
    if(frame._gwrtCloseAfterSave){frame._gwrtCloseAfterSave=false;gwrtModalSetSaving(frame,false);}
  },30000);
}
function gwrtModalPollSave(frame){
  if(frame._gwrtSavePoll)clearInterval(frame._gwrtSavePoll);
  frame._gwrtSaveStartedAt=Date.now();
  frame._gwrtSavePoll=setInterval(function(){
    if(!gwrtModalEl||gwrtModalEl.querySelector('iframe')!==frame){clearInterval(frame._gwrtSavePoll);frame._gwrtSavePoll=null;return;}
    var age=Date.now()-frame._gwrtSaveStartedAt;
    if(gwrtModalFrameHasError(frame)){
      clearInterval(frame._gwrtSavePoll);frame._gwrtSavePoll=null;
      frame._gwrtCloseAfterSave=false;
      gwrtModalSetSaving(frame,false);
      return;
    }
    /* Modern LuCI starts ui.changes.apply() asynchronously and re-enables
     * its button before the apply request completes. Keep the modal open
     * until the iframe reload handler observes the completed write. */
    if(age<30000)return;
    clearInterval(frame._gwrtSavePoll);frame._gwrtSavePoll=null;
    frame._gwrtCloseAfterSave=false;
    gwrtModalSetSaving(frame,false);
  },250);
}
function gwrtModalFrameHasError(frame){
  try{return !!frame.contentDocument.querySelector('.cbi-input-invalid,.alert-message.error,.alert-danger,.alert-error');}catch(e){return true;}
}
function gwrtModalAction(sel,closeOnSuccess){
  var f=gwrtModalEl.querySelector('iframe');
  if(!f)return false;
  try{
    var b;
    if(sel==='.cbi-button-apply'){
      b=f.contentDocument.querySelector('.cbi-page-actions .cbi-button-apply');
      if(!b)b=f.contentDocument.querySelector('.cbi-page-actions input[name="cbi.apply"]');
    }else{
      b=f.contentDocument.querySelector('.cbi-page-actions '+sel);
      if(!b)b=f.contentDocument.querySelector(sel);
    }
    if(!b&&sel==='.cbi-button-apply')b=f.contentDocument.querySelector('.cbi-page-actions .cbi-button-save,input[name="cbi.save"]');
    if(!b||b.disabled)return false;
    if(closeOnSuccess){f._gwrtCloseAfterSave=true;f._gwrtSaveSeenBusy=false;gwrtModalSetSaving(f,true);}
    b.click();
    if(closeOnSuccess)gwrtModalPollSave(f);
    return true;
  }catch(e){if(closeOnSuccess){f._gwrtCloseAfterSave=false;gwrtModalSetSaving(f,false);}return false;}
}
function gwrtModalSyncActions(){
  var f=gwrtModalEl.querySelector('iframe');
  if(!f)return;
  var has=function(sel){try{return !!f.contentDocument.querySelector(sel);}catch(e){return false;}};
  var canApply=has('.cbi-page-actions .cbi-button-apply')||has('.cbi-page-actions input[name="cbi.apply"]');
  var canSave=canApply||has('.cbi-page-actions .cbi-button-save')||has('.cbi-page-actions input[name="cbi.save"]');
  var save=gwrtModalEl.querySelector('.gwrt-modal-save');
  save.style.display=canSave?'':'none';
  save.dataset.gwrtAction=canApply?'apply':'save';
  save.title=canApply?'保存并立即生效':'保存';
  gwrtModalEl.querySelector('.gwrt-modal-reset').style.display=has('.cbi-button-reset')||has('input[name="cbi.reset"]')?'':'none';
}
function gwrtOpenModal(href,title){
  if(!gwrtModalEl){
    gwrtModalEl=document.createElement('div');
    gwrtModalEl.className='gwrt-modal';
    gwrtModalEl.innerHTML='<div class="gwrt-modal-box"><div class="gwrt-modal-head">'
      +'<div class="gwrt-modal-winctl">'
      +'<button type="button" class="gwrt-modal-close" title="关闭">'+gwrtModalIcons.close+'</button>'
      +'<button type="button" class="gwrt-modal-max" title="放大 / 还原">'+gwrtModalIcons.max+'</button>'
      +'</div>'
      +'<span class="gwrt-modal-title"></span>'
      +'<div class="gwrt-modal-actions">'
      +'<button type="button" class="gwrt-modal-save" title="保存">'+gwrtModalIcons.save+'</button>'
      +'<button type="button" class="gwrt-modal-reset" title="复位">'+gwrtModalIcons.reset+'</button>'
      +'</div></div>'
      +'<div class="gwrt-modal-body"></div></div>';
    gwrtModalEl.querySelector('.gwrt-modal-close').addEventListener('click',gwrtCloseModal);
    gwrtModalEl.querySelector('.gwrt-modal-max').addEventListener('click',function(){
      gwrtModalEl.querySelector('.gwrt-modal-box').classList.toggle('gwrt-modal-full');
    });
    gwrtModalEl.querySelector('.gwrt-modal-save').addEventListener('click',function(){var save=gwrtModalEl.querySelector('.gwrt-modal-save');gwrtModalAction(save.dataset.gwrtAction==='apply'?'.cbi-button-apply':'.cbi-button-save',true);});
    gwrtModalEl.querySelector('.gwrt-modal-reset').addEventListener('click',function(){gwrtModalAction('.cbi-button-reset');});
    gwrtModalEl.addEventListener('click',function(e){if(e.target===gwrtModalEl)gwrtCloseModal();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&gwrtModalEl.classList.contains('open'))gwrtCloseModal();});
    document.body.appendChild(gwrtModalEl);
  }
  gwrtModalEl.querySelector('.gwrt-modal-title').textContent=title||'';
  var cleanHref=href+(href.indexOf('?')>=0?'&':'?')+'gwrt_clean=1';
  var oldFrame=gwrtModalEl.querySelector('iframe');
  var body=gwrtModalEl.querySelector('.gwrt-modal-body');
  var box=gwrtModalEl.querySelector('.gwrt-modal-box');
  var isHarbor=href.indexOf('harbor_file')>=0||(title||'').indexOf('Harbor')>=0;
  if(isHarbor){
    box.classList.add('gwrt-modal-full');
  }else{
    box.classList.remove('gwrt-modal-full');
  }
  if(oldFrame)oldFrame.remove();
  body.innerHTML='<div class="gwrt-modal-loading" role="status">正在打开</div>';
  body.setAttribute('aria-busy','true');
  var frame=document.createElement('iframe');
  frame.loading='eager';
  frame.src=cleanHref;
  frame.addEventListener('load',function(){
    if(body.querySelector('iframe')!==frame)return;
    gwrtCleanFrame(frame,isHarbor);
    if(frame._gwrtCloseAfterSave){
      frame._gwrtCloseAfterSave=false;
      if(frame._gwrtSaveTimer)clearTimeout(frame._gwrtSaveTimer);
      if(gwrtModalFrameHasError(frame)){gwrtModalSetSaving(frame,false);}else{setTimeout(function(){if(gwrtModalEl&&gwrtModalEl.querySelector('iframe')===frame)gwrtCloseModal();},120);return;}
    }
    gwrtModalSyncActions();
    setTimeout(gwrtModalSyncActions,700);
    setTimeout(gwrtModalSyncActions,2000);
    var l=body.querySelector('.gwrt-modal-loading');
    if(l)l.remove();
    body.removeAttribute('aria-busy');
  });
  body.appendChild(frame);
  gwrtModalEl.classList.add('open');
}
function gwrtCloseModal(){
  if(!gwrtModalEl)return;
  gwrtModalEl.classList.remove('open');
  var f=gwrtModalEl.querySelector('iframe');
  if(f)setTimeout(function(){if(f.parentNode)f.remove();},200);
  var l=gwrtModalEl.querySelector('.gwrt-modal-loading');
  if(l)setTimeout(function(){if(l.parentNode)l.remove();},200);
}
function gwrtSetupOverviewFold(){
  var head=document.getElementById('gwrtSecOverviewHead'),wrap=document.getElementById('gwrtOvMenuWrap'),divider=document.getElementById('gwrtOvDivider');
  if(!head||!wrap)return;
  var t=null;
  try{t=localStorage.getItem('gwrt-sec-overview');}catch(e){}
  var open=(t==null)?false:t==='1';
  function apply(){
    head.setAttribute('aria-expanded',open?'true':'false');
    head.classList.toggle('open',open);
    wrap.style.display=open?'':'none';
    if(divider)divider.setAttribute('aria-expanded',open?'true':'false');
  }
  function toggle(){open=!open;try{localStorage.setItem('gwrt-sec-overview',open?'1':'0');}catch(e){}apply();}
  if(!head._gwrtBound){head._gwrtBound=true;head.addEventListener('click',toggle);}
  if(divider&&!divider._gwrtBound){divider._gwrtBound=true;divider.addEventListener('click',toggle);}
  apply();
}
function gwrtSetupSecs(){
  [['gwrtSecServiceHead','gwrtSecServicePanel','sec-service'],
   ['gwrtSecStoreHead','gwrtSecStorePanel','sec-store'],
   ['gwrtSecNetHead','gwrtSecNetPanel','sec-net'],
   ['gwrtContainersHead','gwrtContainersPanel','sec-containers']].forEach(function(d){
    var head=document.getElementById(d[0]),panel=document.getElementById(d[1]);
    if(!head||!panel)return;
    var open,t;
    try{t=localStorage.getItem('gwrt-'+d[2]);}catch(e){}
    if(t==null)open=false;
    else open=t==='1';
    function apply(){
      head.classList.toggle('open',open);
      head.setAttribute('aria-expanded',open?'true':'false');
      panel.style.display=open?'':'none';
    }
    head.addEventListener('click',function(){
      open=!open;
      try{localStorage.setItem('gwrt-'+d[2],open?'1':'0');}catch(e){}
      apply();
    });
    apply();
  });
}
var gwrtI18nMap={
  '概述':'Overview','设备状态总览':'Device status overview',
  '系统信息':'System Info','内核':'Kernel','运行时间':'Uptime','本地时间':'Local time','固件':'Firmware',
  'CPU · NSS · 温度':'CPU · NSS · Temp','型号':'Model','频率':'Frequency','运行存储':'Storage','活跃 App':'Active Apps','连接设备':'Devices','连接数':'Connections',
  '网速-EQoS':'Speed-EQoS','日志报错':'Log errors','系统':'System','内核':'Kernel',
  '服务':'Services','存储':'Storage','网络':'Network',
  '网络接口状态图':'Port Status','接入设备':'DHCP Leases','网络拓扑':'Network Topology',
  '展开':'Expand','收起':'Collapse'
};
function gwrtApplyI18n(){
  var isZh=(typeof L!=='undefined'&&L.env&&L.env.lang)?String(L.env.lang).toLowerCase().indexOf('zh')===0:true;
  if(!isZh){
    document.querySelectorAll('[data-i18n]').forEach(function(el){
      var k=el.getAttribute('data-i18n');
      if(gwrtI18nMap[k]!=null)el.textContent=gwrtI18nMap[k];
    });
  }
}
var gwrtGridKeys=['overview','net','service','store'];
var gwrtGridEls={overview:'overviewGrid',net:'netGrid',service:'pluginGrid',store:'storeGrid'};
function gwrtGroupOf(key,legacyKey){
  try{
    var g=JSON.parse(localStorage.getItem('gwrt-move-v1')||'null');
    if(g&&g[key])return g[key];
    if(g&&legacyKey&&g[legacyKey])return g[legacyKey];
  }catch(e){}
  return null;
}
function gwrtSetGroup(key,group){
  try{
    var g=JSON.parse(localStorage.getItem('gwrt-move-v1')||'null')||{};
    if(!group||group==='auto')delete g[key];else g[key]=group;
    localStorage.setItem('gwrt-move-v1',JSON.stringify(g));
  }catch(e){}
}
function gwrtPartitionItems(defs){
  var out={overview:[],net:[],service:[],store:[]};
  for(var gi=0;gi<gwrtGridKeys.length;gi++){
    var key=gwrtGridKeys[gi];
    (defs[key]||[]).forEach(function(it){
      var g=gwrtGroupOf(gwrtItemKey(it),gwrtItemLegacyKey(it));
      if(g&&out[g])out[g].push(it);
      else out[key].push(it);
    });
  }
  return out;
}
function gwrtSetupIconGrids(){
  for(var loadingIndex=0;loadingIndex<gwrtGridKeys.length;loadingIndex++){
    var loadingGrid=document.getElementById(gwrtGridEls[gwrtGridKeys[loadingIndex]]);
    if(loadingGrid&&!loadingGrid.dataset.gwrtLoaded){loadingGrid.setAttribute('aria-busy','true');loadingGrid.innerHTML='<div class="gwrt-grid-loading" aria-label="加载中"></div>';}
  }
  Promise.all([gwrtLoadMenu(),gwrtProbeTtyd()]).then(function(rs){
    var menu=rs[0],hasTtyd=rs[1];
    var parts=gwrtPartitionItems(gwrtGridDefs(menu,hasTtyd));
    for(var gi=0;gi<gwrtGridKeys.length;gi++){
      var key=gwrtGridKeys[gi];
      gwrtRenderGrid(document.getElementById(gwrtGridEls[key]),parts[key],key);
    }
    gwrtBindGridHeaders();
    gwrtSetupSearch();
    gwrtRenderContainers();
  });
}
var GWRT_CONT_ICONS={
  portainer:'portainer',homeassistant:'homeassistant',nextcloud:'nextcloud',n8n:'n8n',jellyfin:'jellyfin',
  nginx:'nginx',redis:'redis',mysql:'mysql',postgres:'postgresql',postgresql:'postgresql',
  openwrt:'openwrt',adguard:'adguard',adguardhome:'adguard',pihole:'pihole',
  qbittorrent:'qbittorrent',transmission:'transmission',grafana:'grafana',prometheus:'prometheus',
  influxdb:'influxdb',wordpress:'wordpress',vaultwarden:'vaultwarden',syncthing:'syncthing',
  zerotier:'zerotier',netdata:'netdata',docker:'docker',cloudflared:'cloudflare',cloudflare:'cloudflare',
  emby:'emby',gitea:'gitea',caddy:'caddy',tailscale:'tailscale',minio:'minio',immich:'immich',
  plex:'plex',sonarr:'sonarr',radarr:'radarr',deluge:'deluge',wireguard:'wireguard',openvpn:'openvpn',
  ghost:'ghost',frigate:'frigate',mongodb:'mongodb',mariadb:'mariadb',rabbitmq:'rabbitmq',
  elasticsearch:'elasticsearch',phpmyadmin:'phpmyadmin',harbor:'harbor',lucky:'lucky'
};
function gwrtContLocalIcon(c){
  var cname=String((c&&(c.Names&&c.Names[0]||c.Name||c.name))||'').replace(/^pm-/,'');
  if(/^[a-z0-9-]{1,32}$/.test(cname))return '/luci-static/podman-market/icons/'+cname+'.png';
  var imgName=String(c.Image||c.image||'');
  var seg=imgName.replace(/^docker\.io\//,'').replace(/^index\.docker\.io\//,'');
  var parts=seg.split('/');
  var last=parts[parts.length-1].split(':')[0].toLowerCase();
  var key=GWRT_CONT_ICONS[last];
  return key?'/luci-static/gwrt/img/containers/'+key+'.svg?v=20260816r79':'';
}
function gwrtContImgNext(img){
  var local=img.getAttribute('data-local');
  if(local&&!img._l){img._l=1;img.src=local;return;}
  gwrtContImgFail(img);
}
window.gwrtContImgNext=gwrtContImgNext;
window.gwrtContLocalIcon=gwrtContLocalIcon;
function gwrtContLetter(name,up){
  var ch=String(name||'?').charAt(0).toUpperCase();
  var bg=up?'#2563eb':'#6b7280';
  return '<svg viewBox="0 0 24 24" class="gwrt-cont-letter"><circle cx="12" cy="12" r="12" fill="'+bg+'"/><text x="12" y="16.5" text-anchor="middle" font-size="13" font-weight="700" fill="#fff" font-family="sans-serif">'+ch+'</text></svg>';
}
function gwrtContImgFail(img){
  var name=img.getAttribute('data-name')||'?';
  var up=img.getAttribute('data-up')==='1';
  img.outerHTML=gwrtContLetter(name,up);
}
window.gwrtContImgFail=gwrtContImgFail;
function gwrtContainerIcon(state){
  var up=(state==='running'||state==='Up'||String(state).toLowerCase().indexOf('up')===0);
  return '<svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="'+(up?'#34d399':'#f87171')+'" stroke-width="1.6"/><path d="M8 4v16M16 4v16M4 8h16M4 16h16" stroke="'+(up?'#34d399':'#f87171')+'" stroke-width="1" opacity=".5"/></svg>';
}
var GWRT_UNSAFE_BROWSER_PORTS={1:1,7:1,9:1,11:1,13:1,15:1,17:1,19:1,20:1,21:1,22:1,23:1,25:1,37:1,42:1,43:1,53:1,69:1,77:1,79:1,87:1,95:1,101:1,102:1,103:1,104:1,109:1,110:1,111:1,113:1,115:1,117:1,119:1,123:1,135:1,137:1,139:1,143:1,161:1,179:1,389:1,427:1,465:1,512:1,513:1,514:1,515:1,526:1,530:1,531:1,532:1,540:1,548:1,554:1,556:1,563:1,587:1,601:1,636:1,993:1,995:1,2049:1,3659:1,4045:1,6000:1,6665:1,6666:1,6667:1,6668:1,6669:1,6697:1,10080:1};
function gwrtBrowserSafePort(value){var raw=String(value||'');if(!/^\d+$/.test(raw))return false;var port=Number(raw);return port>0&&port<65536&&!GWRT_UNSAFE_BROWSER_PORTS[port];}
var GWRT_GENERIC_WEB_PORTS=[3000,80,443,8080,8081,8000,8006,8008,8010,8123,8181,8443,9000,9090,9443,5000,5001,5601,8888,10000];
var GWRT_CONTAINER_WEB_PORTS={
  adguard:[3000,80,443],adguardhome:[3000,80,443],
  lucky:[16601],portainer:[9443,9000],homeassistant:[8123],
  openwrt:[80,443],cockpit:[9090],grafana:[3000],prometheus:[9090]
};
function gwrtPortValue(value){
  var match=String(value===undefined||value===null?'':value).match(/(?:^|:)(\d+)(?:\/(?:tcp|udp))?$/i)||String(value===undefined||value===null?'':value).match(/^(\d+)/);
  return match?match[1]:'';
}
function gwrtPushPort(list,seen,value){
  var port=gwrtPortValue(value);
  if(port&&!seen[port]){seen[port]=1;list.push(port);}
}
function gwrtContainerPortCandidates(c){
  var mapped=[],exposed=[],mappedSeen={},exposedSeen={};
  try{
    if(Array.isArray(c.Ports)){
      c.Ports.forEach(function(p){
        if(!p)return;
        var host=p.hostPort||p.host_port||p.HostPort||p.hostport;
        if(host)gwrtPushPort(mapped,mappedSeen,host);
        else gwrtPushPort(exposed,exposedSeen,p.containerPort||p.container_port||p.ContainerPort||p.port||'');
      });
    }else if(typeof c.Ports==='string'){
      var text=c.Ports,mappedMatch,hasMapped=false,mappedRe=/(?:\[?[0-9a-f:.]+\]?:)?(\d+)\s*->\s*\d+(?:\/(?:tcp|udp))?/ig;
      while((mappedMatch=mappedRe.exec(text))){gwrtPushPort(mapped,mappedSeen,mappedMatch[1]);hasMapped=true;}
      if(!hasMapped){var exposedMatch,exposedRe=/(\d+)\/(?:tcp|udp)/ig;while((exposedMatch=exposedRe.exec(text)))gwrtPushPort(exposed,exposedSeen,exposedMatch[1]);}
    }
    var exposedPorts=c.ExposedPorts||c.exposedPorts||{};
    Object.keys(exposedPorts).forEach(function(key){gwrtPushPort(exposed,exposedSeen,key);});
  }catch(e){}
  return mapped.length?mapped:exposed;
}
function gwrtContainerIdentity(c,name){
  return String(name||'')+' '+String(c.Image||c.image||'');
}
function gwrtContainerPreferredPorts(c,name){
  var identity=gwrtContainerIdentity(c,name).toLowerCase();
  var keys=Object.keys(GWRT_CONTAINER_WEB_PORTS);
  for(var i=0;i<keys.length;i++)if(identity.indexOf(keys[i])>=0)return GWRT_CONTAINER_WEB_PORTS[keys[i]];
  return [];
}
function gwrtContainerWebPorts(c,name){
  var all=gwrtContainerPortCandidates(c).filter(gwrtBrowserSafePort);
  if(!all.length)return [];
  var preferred=gwrtContainerPreferredPorts(c,name);
  var selected=preferred.filter(function(port){return all.indexOf(String(port))>=0;});
  if(!selected.length)selected=GWRT_GENERIC_WEB_PORTS.filter(function(port){return all.indexOf(String(port))>=0;});
  if(!selected.length)selected=all.slice();
  return selected.map(String);
}
function gwrtContainerPortChoiceKey(name){return 'gwrt-container-web-port:'+String(name||'').toLowerCase();}
function gwrtSavedContainerPort(name,ports){
  try{var saved=localStorage.getItem(gwrtContainerPortChoiceKey(name));if(saved&&ports.indexOf(saved)>=0)return saved;}catch(e){}
  return ports[0]||'';
}
function gwrtSaveContainerPort(name,port){try{localStorage.setItem(gwrtContainerPortChoiceKey(name),String(port));}catch(e){}}
function gwrtContainerScheme(port){return Number(port)===443||Number(port)===8443||Number(port)===9443?'https':'http';}
function gwrtContainerWebTargetKey(name){return 'gwrt-container-web-target:'+String(name||'').toLowerCase();}
function gwrtContainerNormalizeWebTarget(value){
  var text=String(value||'').trim(),match=text.match(/^(\d{1,5})(\/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$/);
  if(!match||!gwrtBrowserSafePort(match[1]))return null;
  var path=match[2]||'/';
  if(path.indexOf('//')===0)return null;
  return {port:String(Number(match[1])),path:path};
}
function gwrtContainerManualWebTarget(name){
  try{
    var saved=JSON.parse(localStorage.getItem(gwrtContainerWebTargetKey(name))||'null');
    return saved&&gwrtContainerNormalizeWebTarget(String(saved.port||'')+String(saved.path||'/'));
  }catch(e){return null;}
}
function gwrtContainerWebTarget(name,ports){
  var manual=gwrtContainerManualWebTarget(name);
  if(manual){manual.custom=true;return manual;}
  var port=gwrtSavedContainerPort(name,ports);
  if(!port&&Array.isArray(ports)&&ports.length)port=gwrtBrowserSafePort(ports[0])?ports[0]:'';
  return port?{port:port,path:'/',custom:false}:null;
}
function gwrtSaveContainerWebTarget(name,target){
  try{localStorage.setItem(gwrtContainerWebTargetKey(name),JSON.stringify({port:target.port,path:target.path}));}catch(e){}
}
function gwrtClearContainerWebTarget(name){try{localStorage.removeItem(gwrtContainerWebTargetKey(name));}catch(e){}}
function gwrtContainerWebTargetValue(target){return target?target.port+(target.path||'/'):'';}
function gwrtContainerWebTargetLabel(target){return target?gwrtContainerText('webPort')+' '+target.port+(target.path&&target.path!=='/'?target.path:''):'';}
function gwrtContainerUrl(port,path){return gwrtContainerScheme(port)+'://'+location.hostname+':'+port+(path||'/');}
function gwrtContainerPort(c,name){return gwrtContainerWebPorts(c,name)[0]||gwrtContainerPortCandidates(c)[0]||'';}
var GWRT_CONTAINER_TEXT={
  cn:{runtime:'运行时',dataPath:'数据路径',config:'配置',storage:'挂载空间',mirrors:'镜像加速',images:'已下载镜像',containers:'已部署容器',running:'运行中',normal:'正常',issue:'异常',stopped:'已停止',emptyImages:'暂无已下载镜像',emptyContainers:'未部署容器',refresh:'刷新容器信息',settings:'容器设置',webPort:'Web',blockedPort:'端口受浏览器限制',notEmbedded:'不可内嵌访问',save:'保存',cancel:'取消',close:'关闭',dataPathHelp:'仅允许已挂载的持久化目录。原数据会复制保留，不会自动删除。',browsePath:'浏览目录',chooseHere:'选择当前目录',pathBack:'返回上级',pathRoots:'选择数据分区',pathLoading:'正在读取目录…',pathEmpty:'此目录没有可用子目录',pathBrowseFailed:'无法读取目录',partition:'数据分区',available:'可用',migrate:'确认复制现有容器数据到新路径',restartHint:'保存时会自动停止并重新启动容器',mirrorPreset:'选择镜像加速地址',customMirror:'自定义 HTTPS 镜像地址',addMirror:'添加镜像',noMirrors:'未配置',saving:'正在保存…',saved:'容器设置已保存',loadFailed:'容器服务不可用',version:'版本',mount:'挂载点',volumes:'命名卷',image:'镜像',size:'大小',container:'容器',state:'状态',pathRequired:'请填写数据路径',mirrorInvalid:'镜像地址必须为 HTTPS 地址',editWebTarget:'编辑 Web 地址',webAccess:'Web 访问',webTarget:'端口和路径',webTargetHelp:'例如 3000/ 或 8080/ui/',webTargetInvalid:'请输入可由浏览器打开的端口和路径',resetAuto:'恢复自动识别'},
  en:{runtime:'Runtime',dataPath:'Data path',config:'Config',storage:'Mounted storage',mirrors:'Registry mirrors',images:'Downloaded images',containers:'Deployed containers',running:'Running',normal:'Normal',issue:'Issue',stopped:'Stopped',emptyImages:'No downloaded images',emptyContainers:'No deployed containers',refresh:'Refresh container information',settings:'Container settings',webPort:'Web',blockedPort:'Browser-restricted port',notEmbedded:'Cannot open in the embedded window',save:'Save',cancel:'Cancel',close:'Close',dataPathHelp:'Only a mounted persistent directory is allowed. Existing data is copied and retained.',browsePath:'Browse directories',chooseHere:'Use this directory',pathBack:'Go up',pathRoots:'Choose data partition',pathLoading:'Reading directories…',pathEmpty:'No usable child directories',pathBrowseFailed:'Could not read the directory',partition:'Data partition',available:'Available',migrate:'Confirm copying existing container data to the new path',restartHint:'Saving automatically stops and restarts the containers',mirrorPreset:'Choose a registry mirror',customMirror:'Custom HTTPS registry mirror',addMirror:'Add mirror',noMirrors:'Not configured',saving:'Saving…',saved:'Container settings saved',loadFailed:'Container service is unavailable',version:'Version',mount:'Mount point',volumes:'Named volumes',image:'Image',size:'Size',container:'Container',state:'State',pathRequired:'Enter a data path',mirrorInvalid:'Registry mirrors must use HTTPS',editWebTarget:'Edit Web address',webAccess:'Web access',webTarget:'Port and path',webTargetHelp:'For example: 3000/ or 8080/ui/',webTargetInvalid:'Enter a browser-accessible port and path',resetAuto:'Use automatic detection'}
};
var GWRT_CONTAINER_MIRROR_PRESETS=[
  {name:'1MS',url:'https://docker.1ms.run'},
  {name:'1Panel',url:'https://docker.1panel.live'},
  {name:'DaoCloud',url:'https://docker.m.daocloud.io'},
  {name:'DockerProxy',url:'https://dockerproxy.net'}
];
var gwrtContainerInfoCache=null;
var gwrtContainerLoadPending=null;
function gwrtContainerLang(){return window.GwrtTheme&&GwrtTheme.getLang&&GwrtTheme.getLang()==='en'?'en':'cn';}
function gwrtContainerText(key){return (GWRT_CONTAINER_TEXT[gwrtContainerLang()]||GWRT_CONTAINER_TEXT.cn)[key]||key;}
function gwrtContainerName(c){
  var names=c&&((Array.isArray(c.Names)&&c.Names[0])||(Array.isArray(c.names)&&c.names[0])||c.Names||c.names||c.Name||c.name);
  return String(names||'?').replace(/^\//,'');
}
function gwrtContainerImage(c){return String(c&&((c.Image||c.image||c.Repository||c.repository)||'')||'');}
function gwrtContainerState(c){return String(c&&((c.State||c.state||c.Status||c.status)||'')||'');}
function gwrtContainerRunning(c){return /^(running|up\b)/i.test(gwrtContainerState(c));}
function gwrtContainerHealth(c){
  var state=gwrtContainerState(c),exitCode=c&&(c.ExitCode!==undefined?c.ExitCode:c.exitCode);
  if(gwrtContainerRunning(c))return {kind:'running',label:gwrtContainerText('running')};
  if(/^(created|configured|exited|stopped|paused)/i.test(state)||/\bexited\b/i.test(state)){
    if(exitCode===undefined||exitCode===null||String(exitCode)===''||String(exitCode)==='0')return {kind:'normal',label:gwrtContainerText('stopped')};
  }
  return {kind:'issue',label:gwrtContainerText('issue')};
}
function gwrtContainerFormatKiB(value){
  var bytes=Math.max(0,Number(value)||0)*1024;
  return typeof F==='function'?F(bytes):(bytes/1024/1024).toFixed(1)+' MB';
}
function gwrtContainerSession(){return (typeof L!=='undefined'&&L.env&&L.env.sessionid)?L.env.sessionid:'';}
function gwrtContainerApiUrl(){return '/cgi-bin/gwrt-container?sid='+encodeURIComponent(gwrtContainerSession());}
function gwrtContainerFetch(){
  if(gwrtContainerLoadPending)return gwrtContainerLoadPending;
  gwrtContainerLoadPending=fetch(gwrtContainerApiUrl(),{cache:'no-store'}).then(function(r){
    if(!r.ok)throw new Error('HTTP '+r.status);
    return r.json();
  }).then(function(info){
    if(!info||info.ok!==true)throw new Error(info&&info.error||gwrtContainerText('loadFailed'));
    return info;
  });
  return gwrtContainerLoadPending.then(function(info){gwrtContainerLoadPending=null;return info;},function(error){gwrtContainerLoadPending=null;throw error;});
}
function gwrtContainerBrowseUrl(path){return gwrtContainerApiUrl()+'&action=browse&path='+encodeURIComponent(path||'');}
function gwrtContainerSetPathBrowserOpen(overlay,open){
  var browser=overlay&&overlay.querySelector('[data-gwrt-path-browser]'),button=overlay&&overlay.querySelector('[data-gwrt-path-browse]');
  if(!browser)return;
  browser.hidden=!open;
  if(button)button.setAttribute('aria-expanded',open?'true':'false');
}
function gwrtContainerRenderPathBrowser(overlay,info){
  var browser=overlay&&overlay.querySelector('[data-gwrt-path-browser]'),list=overlay&&overlay.querySelector('[data-gwrt-path-list]');
  var current=overlay&&overlay.querySelector('[data-gwrt-path-current]'),back=overlay&&overlay.querySelector('[data-gwrt-path-back]');
  var choose=overlay&&overlay.querySelector('[data-gwrt-path-choose]'),status=overlay&&overlay.querySelector('[data-gwrt-path-status]');
  if(!browser||!list||!info)return;
  overlay._gwrtBrowseInfo=info;
  var path=String(info.path||''),entries=Array.isArray(info.entries)?info.entries.filter(function(entry){return entry&&typeof entry.path==='string'&&typeof entry.name==='string';}):[];
  if(current){current.textContent=path||gwrtContainerText('pathRoots');current.title=path||gwrtContainerText('pathRoots');}
  if(back)back.disabled=!path;
  if(choose)choose.disabled=!path;
  if(status)status.textContent=entries.length?'':gwrtContainerText('pathEmpty');
  list.innerHTML=entries.length?entries.map(function(entry){
    var mount=entry.mount===true,available=entry.availableKiB;
    var details=mount?'<small>'+esc(entry.path)+' · '+esc(entry.fstype||'-')+(available===undefined||available===null||String(available)===''?'':' · '+esc(gwrtContainerText('available'))+' '+esc(gwrtContainerFormatKiB(available)))+'</small>':'';
    return '<button type="button" class="gwrt-cont-path-entry'+(mount?' gwrt-cont-path-mount':'')+'" data-gwrt-path-enter="'+esc(entry.path)+'"><span class="gwrt-cont-path-entry-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.8c0-1 .8-1.8 1.8-1.8h4l1.8 2h7.6c1 0 1.8.8 1.8 1.8v8.4c0 1-.8 1.8-1.8 1.8H5.3c-1 0-1.8-.8-1.8-1.8V6.8Z"/></svg></span><span class="gwrt-cont-path-entry-copy"><strong>'+esc(entry.name)+'</strong>'+details+'</span><svg class="gwrt-cont-path-entry-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>';
  }).join(''):'<div class="gwrt-cont-path-empty">'+esc(gwrtContainerText('pathEmpty'))+'</div>';
  list.querySelectorAll('[data-gwrt-path-enter]').forEach(function(button){button.addEventListener('click',function(){gwrtContainerLoadPathBrowser(overlay,button.getAttribute('data-gwrt-path-enter'));});});
}
function gwrtContainerLoadPathBrowser(overlay,path){
  var browser=overlay&&overlay.querySelector('[data-gwrt-path-browser]'),list=overlay&&overlay.querySelector('[data-gwrt-path-list]'),status=overlay&&overlay.querySelector('[data-gwrt-path-status]');
  if(!browser||!list)return;
  var token=(overlay._gwrtBrowseToken||0)+1;
  overlay._gwrtBrowseToken=token;
  gwrtContainerSetPathBrowserOpen(overlay,true);
  list.innerHTML='<div class="gwrt-cont-path-empty">'+esc(gwrtContainerText('pathLoading'))+'</div>';
  if(status)status.textContent='';
  fetch(gwrtContainerBrowseUrl(path),{cache:'no-store'}).then(function(response){
    if(!response.ok)throw new Error('HTTP '+response.status);
    return response.json();
  }).then(function(info){
    if(!info||info.ok!==true||info.action!=='browse')throw new Error(info&&info.error||gwrtContainerText('pathBrowseFailed'));
    if(overlay._gwrtBrowseToken===token)gwrtContainerRenderPathBrowser(overlay,info);
  }).catch(function(error){
    if(overlay._gwrtBrowseToken!==token)return;
    list.innerHTML='<div class="gwrt-cont-path-empty">'+esc(gwrtContainerText('pathBrowseFailed'))+'</div>';
    if(status)status.textContent='';
    try{console.warn('GWRT container path browse failed',error);}catch(e){}
  });
}
function gwrtContainerRenderCards(list){
  var grid=document.getElementById('containerGrid'),targetRecords={};
  if(!grid)return;
  list=Array.isArray(list)?list:[];
  if(!list.length){grid.innerHTML='<div class="gwrt-cont-empty">'+esc(gwrtContainerText('emptyContainers'))+'</div>';return;}
  grid.innerHTML=list.map(function(c,index){
    var name=gwrtContainerName(c),img=gwrtContainerImage(c),state=gwrtContainerState(c);
    var ports=gwrtContainerWebPorts(c,name),target=gwrtContainerWebTarget(name,ports),port=target&&target.port||'',rawPort=gwrtContainerPort(c,name);
    var up=gwrtContainerRunning(c),canOpen=up&&target&&gwrtBrowserSafePort(port),health=gwrtContainerHealth(c);
    var targetLabel=gwrtContainerWebTargetLabel(target),tip=esc(name)+' · '+esc(img)+(targetLabel?' · '+esc(targetLabel):(rawPort?' · '+gwrtContainerText('webPort')+' '+esc(rawPort):''));
    var local=gwrtContLocalIcon(c);
    var ico=local?'<img src="'+esc(local)+'" data-name="'+esc(name)+'" data-up="'+(up?'1':'0')+'" alt="" loading="lazy" class="gwrt-cont-logo" onerror="gwrtContImgFail(this)">':gwrtContLetter(name,up);
    var dotPort=rawPort||(target&&target.port)||'';
    var dot=dotPort?'<span class="gwrt-cont-dot" style="background:'+(up?'#34d399':(health.kind==='issue'?'#f87171':'#94a3b8'))+'"></span>':'';
    var stateText=target?(canOpen?targetLabel:(up?(targetLabel+' · '+gwrtContainerText('blockedPort')):health.label)):(rawPort?(up?(rawPort+' · '+gwrtContainerText('notEmbedded')):health.label):health.label);
    var toggle=up
      ?'<button type="button" class="gwrt-cont-toggle" data-gwrt-cont-toggle="stop" data-name="'+esc(name)+'" title="停止容器">■</button>'
      :'<button type="button" class="gwrt-cont-toggle" data-gwrt-cont-toggle="start" data-name="'+esc(name)+'" title="启动容器">▶</button>';
    var picker=ports.length>1&&(!target||!target.custom)?'<label class="gwrt-cont-port-picker" title="'+esc(gwrtContainerText('webPort'))+'"><span>'+esc(gwrtContainerText('webPort'))+'</span><select class="gwrt-cont-port-select" aria-label="'+esc(gwrtContainerText('webPort'))+' '+esc(name)+'">'+ports.map(function(p){return '<option value="'+esc(p)+'"'+(p===port?' selected':'')+'>'+esc(p)+'</option>';}).join('')+'</select></label>':'';
    var del=up?'':'<button type="button" class="gwrt-cont-del" data-name="'+esc(name)+'" title="删除容器（仅停止状态可删除）" aria-label="删除容器">✕</button>';
    var edit='<button type="button" class="gwrt-cont-port-edit" data-gwrt-container-web-edit="'+index+'" title="'+esc(gwrtContainerText('editWebTarget'))+'" aria-label="'+esc(gwrtContainerText('editWebTarget'))+'"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/></svg></button>';
    targetRecords[index]={name:name,ports:ports,target:target};
    return '<div class="gwrt-cont-item'+(canOpen?' gwrt-cont-open':'')+'"'+(canOpen?' data-port="'+esc(port)+'" data-gwrt-web-path="'+esc(target.path||'/')+'"':'')+' data-container-name="'+esc(name)+'" title="'+tip+'">'+del+'<span class="gwrt-cont-ico">'+ico+dot+'</span><span class="gwrt-cont-name">'+esc(name)+'</span><span class="gwrt-cont-state gwrt-cont-state-'+health.kind+'">'+esc(stateText||state)+'</span><span class="gwrt-cont-web-row">'+picker+edit+'</span><span class="gwrt-cont-ctl">'+toggle+'</span></div>';
  }).join('');
  grid.querySelectorAll('.gwrt-cont-port-select').forEach(function(select){
    select.addEventListener('click',function(ev){ev.stopPropagation();});
    select.addEventListener('change',function(ev){
      ev.stopPropagation();
      var item=select.closest('.gwrt-cont-item'),port=select.value;
      if(!item||!gwrtBrowserSafePort(port))return;
      item.setAttribute('data-port',port);
      item.setAttribute('data-gwrt-web-path','/');
      item.classList.add('gwrt-cont-open');
      gwrtClearContainerWebTarget(item.getAttribute('data-container-name'));
      gwrtSaveContainerPort(item.getAttribute('data-container-name'),port);
      var stateEl=item.querySelector('.gwrt-cont-state');
      if(stateEl)stateEl.textContent=gwrtContainerText('webPort')+' '+port;
    });
  });
  grid.querySelectorAll('[data-gwrt-cont-del]').forEach(function(button){
    button.addEventListener('click',function(ev){
      ev.preventDefault();ev.stopPropagation();
      var name=button.getAttribute('data-name');
      if(!name)return;
      if(!window.confirm('删除容器 '+name+'？（数据目录会保留）'))return;
      button.disabled=true;
      rpc('podmanmarket','action',{id:name,op:'remove'}).then(function(r){
        if(r&&r.__rpcError!==undefined){if(typeof gwrtToast==='function')gwrtToast('删除失败','error');button.disabled=false;return;}
        gwrtRenderContainers(true);
      });
    });
  });
  grid.querySelectorAll('[data-gwrt-cont-toggle]').forEach(function(button){
    button.addEventListener('click',function(ev){
      ev.preventDefault();ev.stopPropagation();
      var op=button.getAttribute('data-gwrt-cont-toggle'),name=button.getAttribute('data-name');
      if(!name)return;
      button.disabled=true;button.textContent='…';
      rpc('podmanmarket','action',{id:name,op:op}).then(function(r){
        button.disabled=false;
        if(r&&r.__rpcError!==undefined){if(typeof gwrtToast==='function')gwrtToast('容器操作失败', 'error');button.textContent=op==='start'?'▶':'■';return;}
        gwrtRenderContainers(true);
      });
    });
  });
  grid.querySelectorAll('[data-gwrt-container-web-edit]').forEach(function(button){
    button.addEventListener('click',function(ev){
      ev.preventDefault();ev.stopPropagation();
      var record=targetRecords[button.getAttribute('data-gwrt-container-web-edit')];
      if(record)gwrtOpenContainerWebEditor(record);
    });
  });
  grid.querySelectorAll('.gwrt-cont-item[data-port]').forEach(function(el){
    el.addEventListener('click',function(){
      var port=el.getAttribute('data-port');
      if(port)gwrtOpenModal(gwrtContainerUrl(port,el.getAttribute('data-gwrt-web-path')),el.querySelector('.gwrt-cont-name').textContent);
    });
  });
}
function gwrtCloseContainerWebEditor(){var overlay=document.getElementById('gwrtContainerWebEditor');if(overlay)overlay.classList.remove('open');}
function gwrtOpenContainerWebEditor(record){
  var overlay=document.getElementById('gwrtContainerWebEditor');
  if(!overlay){
    overlay=document.createElement('div');overlay.id='gwrtContainerWebEditor';overlay.className='gwrt-container-web-editor';document.body.appendChild(overlay);
    overlay.addEventListener('click',function(event){if(event.target===overlay)gwrtCloseContainerWebEditor();});
    document.addEventListener('keydown',function(event){if(event.key==='Escape'&&overlay.classList.contains('open'))gwrtCloseContainerWebEditor();});
  }
  var target=record.target||gwrtContainerWebTarget(record.name,record.ports),value=gwrtContainerWebTargetValue(target);
  overlay.innerHTML='<div class="gwrt-cont-web-editor-box" role="dialog" aria-modal="true" aria-label="'+esc(gwrtContainerText('webAccess'))+'"><div class="gwrt-cont-web-editor-head"><div><strong>'+esc(gwrtContainerText('webAccess'))+'</strong><span>'+esc(record.name)+'</span></div><button type="button" data-gwrt-web-editor-close title="'+esc(gwrtContainerText('close'))+'" aria-label="'+esc(gwrtContainerText('close'))+'"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div><div class="gwrt-cont-web-editor-body"><label class="gwrt-cont-field"><span>'+esc(gwrtContainerText('webTarget'))+'</span><input type="text" data-gwrt-web-target value="'+esc(value)+'" placeholder="3000/" inputmode="url" spellcheck="false" autocomplete="off"><small>'+esc(gwrtContainerText('webTargetHelp'))+'</small></label></div><div class="gwrt-cont-web-editor-actions"><button type="button" class="gwrt-cont-btn secondary" data-gwrt-web-target-reset>'+esc(gwrtContainerText('resetAuto'))+'</button><span></span><button type="button" class="gwrt-cont-btn secondary" data-gwrt-web-editor-close>'+esc(gwrtContainerText('cancel'))+'</button><button type="button" class="gwrt-cont-btn primary" data-gwrt-web-target-save>'+esc(gwrtContainerText('save'))+'</button></div></div>';
  var input=overlay.querySelector('[data-gwrt-web-target]');
  overlay.querySelectorAll('[data-gwrt-web-editor-close]').forEach(function(button){button.addEventListener('click',gwrtCloseContainerWebEditor);});
  overlay.querySelector('[data-gwrt-web-target-reset]').addEventListener('click',function(){
    gwrtClearContainerWebTarget(record.name);
    if(gwrtContainerInfoCache)gwrtContainerRenderCards(gwrtContainerInfoCache.containers);
    gwrtCloseContainerWebEditor();
  });
  overlay.querySelector('[data-gwrt-web-target-save]').addEventListener('click',function(){
    var parsed=gwrtContainerNormalizeWebTarget(input.value);
    if(!parsed){gwrtToast(gwrtContainerText('webTargetInvalid'),'error');input.focus();return;}
    gwrtSaveContainerWebTarget(record.name,parsed);
    if(gwrtContainerInfoCache)gwrtContainerRenderCards(gwrtContainerInfoCache.containers);
    gwrtCloseContainerWebEditor();
  });
  input.addEventListener('keydown',function(event){if(event.key==='Enter'){event.preventDefault();overlay.querySelector('[data-gwrt-web-target-save]').click();}});
  overlay.classList.add('open');
  setTimeout(function(){input.focus();input.select();},0);
}
function gwrtContainerImageLabel(image){
  var repo=image&&(image.Repository||image.repository||image.Names||image.names||image.Image||image.image);
  var tag=image&&(image.Tag||image.tag);
  if(Array.isArray(repo))repo=repo[0];
  repo=String(repo||'?');
  return tag&&tag!=='<none>'&&repo.indexOf(':')<0?repo+':'+tag:repo;
}
function gwrtContainerImageSize(image){
  var value=image&&((image.Size||image.size||image.VirtualSize||image.virtualSize)||'');
  if(typeof value==='number'||/^\d+$/.test(String(value)))return typeof F==='function'?F(Number(value)):String(value);
  return String(value||'-');
}
function gwrtContainerRenderSummary(info){
  var summary=document.getElementById('gwrtContainerSummary');
  if(!summary)return;
  var containers=Array.isArray(info.containers)?info.containers:[],images=Array.isArray(info.images)?info.images:[];
  var running=0,normal=0,issue=0;
  containers.forEach(function(c){var h=gwrtContainerHealth(c);if(h.kind==='running')running++;else if(h.kind==='normal')normal++;else issue++;});
  var mirrors=Array.isArray(info.mirrors)?info.mirrors.filter(Boolean):[];
  var storage=info.storage||{};
  var imageRows=images.length?images.map(function(image){return '<li><span title="'+esc(gwrtContainerImageLabel(image))+'">'+esc(gwrtContainerImageLabel(image))+'</span><em>'+esc(gwrtContainerImageSize(image))+'</em></li>';}).join(''):'<li class="gwrt-cont-list-empty">'+esc(gwrtContainerText('emptyImages'))+'</li>';
  var containerRows=containers.length?containers.map(function(c){var h=gwrtContainerHealth(c);return '<li><span title="'+esc(gwrtContainerName(c))+'">'+esc(gwrtContainerName(c))+'</span><em class="gwrt-cont-health '+h.kind+'">'+esc(h.label)+'</em></li>';}).join(''):'<li class="gwrt-cont-list-empty">'+esc(gwrtContainerText('emptyContainers'))+'</li>';
  summary.innerHTML='<div class="gwrt-cont-toolbar"><div class="gwrt-cont-runtime"><strong>'+esc(String(info.engine||'').toUpperCase())+'</strong><span>'+esc(gwrtContainerText('version'))+' '+esc(info.version||'-')+'</span><span>'+Number(info.volumeCount||0)+' '+esc(gwrtContainerText('volumes'))+'</span><span class="gwrt-cont-count running">'+running+' '+esc(gwrtContainerText('running'))+'</span><span class="gwrt-cont-count normal">'+normal+' '+esc(gwrtContainerText('normal'))+'</span>'+(issue?'<span class="gwrt-cont-count issue">'+issue+' '+esc(gwrtContainerText('issue'))+'</span>':'')+'</div><div class="gwrt-cont-tools"><button type="button" class="gwrt-cont-icon-btn" data-gwrt-container-action="refresh" title="'+esc(gwrtContainerText('refresh'))+'" aria-label="'+esc(gwrtContainerText('refresh'))+'"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0 2 5.3"/><path d="M20 4v7h-7"/></svg></button><button type="button" class="gwrt-cont-icon-btn" data-gwrt-container-action="settings" title="'+esc(gwrtContainerText('settings'))+'" aria-label="'+esc(gwrtContainerText('settings'))+'"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.12 2.12-.06-.06a1.7 1.7 0 0 0-1.88-.34 1.7 1.7 0 0 0-1.04 1.56V20.3h-3v-.08A1.7 1.7 0 0 0 10.66 18.66a1.7 1.7 0 0 0-1.88.34l-.06.06-2.12-2.12.06-.06A1.7 1.7 0 0 0 7 15a1.7 1.7 0 0 0-1.56-1.04H5.3v-3h.14A1.7 1.7 0 0 0 7 9.92a1.7 1.7 0 0 0-.34-1.88L6.6 7.98l2.12-2.12.06.06a1.7 1.7 0 0 0 1.88.34A1.7 1.7 0 0 0 11.7 4.7v-.08h3v.08a1.7 1.7 0 0 0 1.04 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.12 2.12-.06.06A1.7 1.7 0 0 0 19.4 9.92 1.7 1.7 0 0 0 20.96 11H21.1v3h-.14A1.7 1.7 0 0 0 19.4 15Z"/></svg></button></div></div><div class="gwrt-cont-info-grid"><dl><dt>'+esc(gwrtContainerText('dataPath'))+'</dt><dd title="'+esc(info.dataPath||'-')+'">'+esc(info.dataPath||'-')+'</dd></dl><dl><dt>'+esc(gwrtContainerText('storage'))+'</dt><dd>'+esc(storage.mount||'-')+' · '+esc(gwrtContainerFormatKiB(storage.usedKiB))+' / '+esc(gwrtContainerFormatKiB(storage.sizeKiB))+'</dd></dl><dl><dt>'+esc(gwrtContainerText('mirrors'))+'</dt><dd title="'+esc(mirrors.join(', '))+'">'+esc(mirrors.join(', ')||gwrtContainerText('noMirrors'))+'</dd></dl><dl><dt>'+esc(gwrtContainerText('config'))+'</dt><dd title="'+esc(info.configPath||'-')+'">'+esc(info.configPath||'-')+'</dd></dl></div><div class="gwrt-cont-lists"><section><h4>'+esc(gwrtContainerText('containers'))+' <small>'+containers.length+'</small></h4><ul>'+containerRows+'</ul></section><section><h4>'+esc(gwrtContainerText('images'))+' <small>'+images.length+'</small></h4><ul>'+imageRows+'</ul></section></div>';
  summary.querySelectorAll('[data-gwrt-container-action]').forEach(function(button){
    button.addEventListener('click',function(){
      if(button.getAttribute('data-gwrt-container-action')==='settings')gwrtOpenContainerSettings(info);
      else gwrtRenderContainers(true);
    });
  });

}
function gwrtCloseContainerSettings(){var overlay=document.getElementById('gwrtContainerSettings');if(overlay)overlay.classList.remove('open');}
function gwrtContainerRenderMirrorList(overlay){
  var list=overlay&&overlay.querySelector('[data-gwrt-container-mirrors]');
  if(!list)return;
  var mirrors=overlay._gwrtMirrors||[];
  list.innerHTML=mirrors.length?mirrors.map(function(mirror,index){return '<li><code>'+esc(mirror)+'</code><button type="button" data-gwrt-mirror-remove="'+index+'" aria-label="'+esc(gwrtContainerText('close'))+'" title="'+esc(gwrtContainerText('close'))+'"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></li>';}).join(''):'<li class="gwrt-cont-list-empty">'+esc(gwrtContainerText('noMirrors'))+'</li>';
  list.querySelectorAll('[data-gwrt-mirror-remove]').forEach(function(button){button.addEventListener('click',function(){overlay._gwrtMirrors.splice(Number(button.getAttribute('data-gwrt-mirror-remove')),1);gwrtContainerRenderMirrorList(overlay);});});
}
function gwrtContainerAddMirror(overlay,value){
  value=String(value||'').trim().replace(/\/$/,'');
  if(!/^https:\/\/[A-Za-z0-9.-]+(?::\d+)?$/.test(value)){gwrtToast(gwrtContainerText('mirrorInvalid'),'error');return false;}
  if(overlay._gwrtMirrors.indexOf(value)<0)overlay._gwrtMirrors.push(value);
  gwrtContainerRenderMirrorList(overlay);
  return true;
}
function gwrtContainerSaveSettings(overlay){
  var path=overlay.querySelector('[name="data_path"]'),save=overlay.querySelector('[data-gwrt-container-save]');
  if(!path||!path.value.trim()){gwrtToast(gwrtContainerText('pathRequired'),'error');return;}
  var body=new URLSearchParams();
  body.set('action','save');body.set('data_path',path.value.trim());body.set('mirrors',(overlay._gwrtMirrors||[]).join('\n'));
  body.set('migrate',overlay.querySelector('[name="migrate"]').checked?'1':'0');
  save.disabled=true;save.textContent=gwrtContainerText('saving');
  fetch(gwrtContainerApiUrl(),{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8','X-Requested-With':'XMLHttpRequest'},body:body.toString()}).then(function(r){return r.json();}).then(function(info){
    if(!info||info.ok!==true)throw new Error(info&&info.error||gwrtContainerText('loadFailed'));
    gwrtContainerInfoCache=info;gwrtContainerRenderCards(info.containers);gwrtContainerRenderSummary(info);gwrtCloseContainerSettings();gwrtToast(gwrtContainerText('saved'),'success');
  }).catch(function(error){gwrtToast(String(error&&error.message||error),'error');save.disabled=false;save.textContent=gwrtContainerText('save');});
}
function gwrtOpenContainerSettings(info){
  var overlay=document.getElementById('gwrtContainerSettings');
	if(!overlay){
		overlay=document.createElement('div');overlay.id='gwrtContainerSettings';overlay.className='gwrt-container-settings';document.body.appendChild(overlay);
		overlay.addEventListener('click',function(event){if(event.target===overlay)gwrtCloseContainerSettings();});
		document.addEventListener('keydown',function(event){if(event.key==='Escape'&&overlay.classList.contains('open'))gwrtCloseContainerSettings();});
	}
  var presets='<option value="">'+esc(gwrtContainerText('mirrorPreset'))+'</option>'+GWRT_CONTAINER_MIRROR_PRESETS.map(function(p){return '<option value="'+esc(p.url)+'">'+esc(p.name)+' · '+esc(p.url)+'</option>';}).join('');
  var pathField='<div class="gwrt-cont-field"><span>'+esc(gwrtContainerText('dataPath'))+'</span><div class="gwrt-cont-path-input"><input name="data_path" type="text" spellcheck="false" value="'+esc(info.dataPath||'')+'"><button type="button" class="gwrt-cont-icon-btn" data-gwrt-path-browse title="'+esc(gwrtContainerText('browsePath'))+'" aria-label="'+esc(gwrtContainerText('browsePath'))+'" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.8c0-1 .8-1.8 1.8-1.8h4l1.8 2h7.6c1 0 1.8.8 1.8 1.8v8.4c0 1-.8 1.8-1.8 1.8H5.3c-1 0-1.8-.8-1.8-1.8V6.8Z"/></svg></button></div><small>'+esc(gwrtContainerText('dataPathHelp'))+'</small><div class="gwrt-cont-path-browser" data-gwrt-path-browser hidden><div class="gwrt-cont-path-browser-head"><button type="button" class="gwrt-cont-icon-btn" data-gwrt-path-back title="'+esc(gwrtContainerText('pathBack'))+'" aria-label="'+esc(gwrtContainerText('pathBack'))+'" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><code data-gwrt-path-current></code><button type="button" class="gwrt-cont-btn secondary" data-gwrt-path-choose disabled>'+esc(gwrtContainerText('chooseHere'))+'</button></div><div class="gwrt-cont-path-list" data-gwrt-path-list></div><div class="gwrt-cont-path-status" data-gwrt-path-status aria-live="polite"></div></div></div>';
  overlay.innerHTML='<div class="gwrt-container-settings-box" role="dialog" aria-modal="true" aria-label="'+esc(gwrtContainerText('settings'))+'"><div class="gwrt-container-settings-head"><div><strong>'+esc(gwrtContainerText('settings'))+'</strong><span>'+esc(String(info.engine||'').toUpperCase())+' '+esc(info.version||'')+'</span></div><button type="button" data-gwrt-container-close title="'+esc(gwrtContainerText('close'))+'" aria-label="'+esc(gwrtContainerText('close'))+'"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div><div class="gwrt-container-settings-body">'+pathField+'<label class="gwrt-cont-check"><input name="migrate" type="checkbox"><span>'+esc(gwrtContainerText('migrate'))+'</span></label><small style="display:block;color:var(--text-tertiary,#888);margin:2px 0 6px">'+esc(gwrtContainerText('restartHint'))+'</small><div class="gwrt-cont-mirror-field"><span>'+esc(gwrtContainerText('mirrors'))+'</span><div class="gwrt-cont-mirror-add"><select data-gwrt-mirror-preset>'+presets+'</select><input type="url" data-gwrt-custom-mirror placeholder="'+esc(gwrtContainerText('customMirror'))+'" spellcheck="false"><button type="button" data-gwrt-add-custom title="'+esc(gwrtContainerText('addMirror'))+'" aria-label="'+esc(gwrtContainerText('addMirror'))+'"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></button></div><ul class="gwrt-cont-mirror-list" data-gwrt-container-mirrors></ul></div></div><div class="gwrt-container-settings-actions"><button type="button" class="gwrt-cont-btn secondary" data-gwrt-container-close>'+esc(gwrtContainerText('cancel'))+'</button><button type="button" class="gwrt-cont-btn primary" data-gwrt-container-save>'+esc(gwrtContainerText('save'))+'</button></div></div>';
  overlay._gwrtMirrors=(Array.isArray(info.mirrors)?info.mirrors:[]).filter(Boolean).slice();
  overlay._gwrtBrowseInfo=null;
  gwrtContainerRenderMirrorList(overlay);
  overlay.querySelectorAll('[data-gwrt-container-close]').forEach(function(button){button.addEventListener('click',gwrtCloseContainerSettings);});
  overlay.querySelector('[data-gwrt-mirror-preset]').addEventListener('change',function(){var select=this,input=overlay.querySelector('[data-gwrt-custom-mirror]');if(select.value){input.value=select.value;select.value='';}});
  overlay.querySelector('[data-gwrt-add-custom]').addEventListener('click',function(){var input=overlay.querySelector('[data-gwrt-custom-mirror]');if(gwrtContainerAddMirror(overlay,input.value))input.value='';});
  overlay.querySelector('[data-gwrt-custom-mirror]').addEventListener('keydown',function(event){if(event.key==='Enter'){event.preventDefault();overlay.querySelector('[data-gwrt-add-custom]').click();}});
  overlay.querySelector('[data-gwrt-path-browse]').addEventListener('click',function(){
    var browser=overlay.querySelector('[data-gwrt-path-browser]');
    if(browser.hidden)gwrtContainerLoadPathBrowser(overlay,'');else gwrtContainerSetPathBrowserOpen(overlay,false);
  });
  overlay.querySelector('[data-gwrt-path-back]').addEventListener('click',function(){
    var current=overlay._gwrtBrowseInfo||{};
    if(current.path)gwrtContainerLoadPathBrowser(overlay,current.parent||'');
  });
  overlay.querySelector('[data-gwrt-path-choose]').addEventListener('click',function(){
    var current=overlay._gwrtBrowseInfo||{},input=overlay.querySelector('[name="data_path"]');
    if(current.path&&input){input.value=current.path;gwrtContainerSetPathBrowserOpen(overlay,false);input.focus();}
  });
  overlay.querySelector('[data-gwrt-container-save]').addEventListener('click',function(){gwrtContainerSaveSettings(overlay);});
  overlay.classList.add('open');
}
function gwrtRenderContainers(force){
  var grid=document.getElementById('containerGrid'),summary=document.getElementById('gwrtContainerSummary');
  if(!grid)return;
  if(!force&&gwrtContainerInfoCache){gwrtContainerRenderCards(gwrtContainerInfoCache.containers);gwrtContainerRenderSummary(gwrtContainerInfoCache);return;}
  grid.innerHTML='<div class="gwrt-cont-empty">'+esc(gwrtContainerText('runtime'))+'…</div>';
  if(summary)summary.innerHTML='';
  gwrtContainerFetch().then(function(info){
    gwrtContainerInfoCache=info;
    var engine=document.getElementById('gwrtContainerEngine');
    if(engine){engine.textContent=info.engine==='podman'?'Podman':'Docker';engine.setAttribute('data-container-engine',info.engine||'');}
    gwrtContainerRenderCards(info.containers);gwrtContainerRenderSummary(info);
  }).catch(function(error){
    grid.innerHTML='<div class="gwrt-cont-empty">'+esc(gwrtContainerText('loadFailed'))+'</div>';
    if(summary)summary.innerHTML='';
    try{console.warn('GWRT container info failed',error);}catch(e){}
  });
}
var gwrtSearchAll=[];
function gwrtSetupSearch(){
  var input=document.getElementById('gwrtSearchInput'),drop=document.getElementById('gwrtSearchDrop'),wrap=document.getElementById('gwrtSearch');
  if(!input||!drop)return;
  if(input._gwrtBound)return;
  input._gwrtBound=true;
  gwrtLoadMenu().then(function(menu){
    var defs=gwrtGridDefs(menu),parts=gwrtPartitionItems(defs),seen={};
    gwrtSearchAll=[];
    for(var gi=0;gi<gwrtGridKeys.length;gi++){
      var key=gwrtGridKeys[gi];
      (parts[key]||[]).forEach(function(it){
        var k=it.name;
        if(seen[k])return;
        seen[k]=1;
        gwrtSearchAll.push({name:it.name,title:it.title,icon:it.icon,href:it.href});
      });
    }
  });
  function closeDrop(){
    drop.innerHTML='';
    drop.style.display='none';
    wrap.classList.remove('open');
  }
  function onInput(){
    var q=input.value.trim().toLowerCase();
    if(!q){closeDrop();return;}
    var out=[];
    for(var i=0;i<gwrtSearchAll.length;i++){
      var it=gwrtSearchAll[i];
      var hay=(it.title+' '+it.name+' '+it.href).toLowerCase();
      if(hay.indexOf(q)>=0)out.push(it);
    }
    if(!out.length){
      drop.innerHTML='<div class="gwrt-search-empty">无匹配</div>';
      drop.style.display='block';
      wrap.classList.add('open');
      return;
    }
    drop.innerHTML=out.slice(0,12).map(function(it){
      return '<div class="gwrt-search-item" data-href="'+esc(it.href)+'" data-title="'+esc(it.title)+'"><span class="gwrt-search-item-ico">'+gwrtIcon(it.icon)+'</span><span class="gwrt-search-item-t">'+esc(it.title)+'</span></div>';
    }).join('');
    drop.style.display='block';
    wrap.classList.add('open');
    drop.querySelectorAll('.gwrt-search-item').forEach(function(el){
      el.addEventListener('click',function(){
        var href=el.getAttribute('data-href'),title=el.getAttribute('data-title');
        gwrtOpenModal(href,title);
        input.value='';
        closeDrop();
      });
    });
  }
  input.addEventListener('input',onInput);
  input.addEventListener('keydown',function(e){
    if(e.key==='Enter'){
      var first=drop.querySelector('.gwrt-search-item');
      if(first)first.click();
    }else if(e.key==='Escape'){
      closeDrop();
    }
  });
  document.addEventListener('click',function(e){
    if(!wrap.contains(e.target))closeDrop();
  });
}
function gwrtBindGridHeaders(){
  var map={gwrtSecOverviewHead:'overview',gwrtSecServiceHead:'service',gwrtSecStoreHead:'store',gwrtSecNetHead:'net'};
  for(var id in map){
    var head=document.getElementById(id);
    if(!head||head._gwrtDropBound)continue;
    head._gwrtDropBound=true;
    let grp=map[id];
    head.addEventListener('dragover',function(e){
      if(gwrtDrag&&gwrtDrag.el){
        e.preventDefault();
        this.classList.add('gwrt-drop-hover');
      }
    });
    head.addEventListener('dragleave',function(){
      this.classList.remove('gwrt-drop-hover');
    });
    head.addEventListener('drop',function(e){
      e.preventDefault();
      this.classList.remove('gwrt-drop-hover');
      if(!gwrtDrag||!gwrtDrag.el)return;
      var targetGrid=document.getElementById(gwrtGridEls[grp]);
      if(!targetGrid)return;
      targetGrid.appendChild(gwrtDrag.el);
      gwrtPersistDrag(gwrtDrag,targetGrid);
    });
  }
}
if(document.getElementById('gwrtHostname')){
  gwrtApplyI18n();
  setupLeasesFold();
  gwrtSetupOverviewFold();
  gwrtSetupSecs();
  gwrtLoadMenu();
  gwrtSetupIconGrids();
  setupEqosControls();
  refreshEqosCard();
  loadOuiDb();
  gwrtLoadDeviceLabels();
  document.addEventListener('click',function(ev){
    var t=ev.target;
    while(t&&t!==document&&!(t.getAttribute&&t.getAttribute('data-gwrt-label-mac')))t=t.parentNode;
    if(!t||t===document)return;
    ev.preventDefault();ev.stopPropagation();
    gwrtOpenDeviceLabel(t.getAttribute('data-gwrt-label-mac'));
  });
  resumeDashboard();
  gwrtCheckOta();
  document.addEventListener('visibilitychange',function(){
    if(document.hidden){clearTimeout(dashboardRefreshTimer);clearTimeout(logRefreshTimer);}
    else resumeDashboard();
  });
  window.addEventListener('pagehide',function(){
    dashboardStopped=true;clearTimeout(dashboardRefreshTimer);clearTimeout(logRefreshTimer);
  });
}
})();
</script>

{% include('footer') %}
