CONFIG_PACKAGE_luci-theme-gwrt=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-bandix-plus=y
CONFIG_PACKAGE_bandix-plus=y
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-openclash=y
# gecoosac 通过 /tmp/gecoosac-apk 离线 APK 预置（见 34_gwrt-gecoosac-apk），不走 opkg 编译
# CONFIG_PACKAGE_luci-app-gecoosac is not set
# CONFIG_PACKAGE_gecoosac is not set
